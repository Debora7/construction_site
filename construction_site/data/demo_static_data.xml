<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="product_product_cement" model="product.product">
            <field name="name">Sac Ciment 50kg</field>
            <field name="type">product</field>
        </record>
        <record id="product_product_rebar" model="product.product">
            <field name="name">Bară oțel beton 12mm</field>
            <field name="type">product</field>
        </record>
        <record id="product_product_gravel" model="product.product">
            <field name="name">Pietriș Tona</field>
            <field name="type">product</field>
        </record>
        <record id="product_product_bricks" model="product.product">
            <field name="name">Cărămizi Roșii (x1000)</field>
            <field name="type">product</field>
        </record>
        <record id="product_product_subcontracting" model="product.product">
            <field name="name">Servicii Subcontractare Construcții</field>
            <field name="type">service</field>
        </record>
        <record id="seq_project_category" model="ir.sequence">
            <field name="name">Project Category Sequence</field>
            <field name="code">project.category</field>
            <field name="prefix">CAT/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="project_category_rezidential" model="project.category">
            <field name="name">Construcții Rezidențiale</field>
            <field name="project_sequence_id" ref="seq_project_category"/>
        </record>
        <record id="project_category_industrial" model="project.category">
            <field name="name">Construcții Industriale</field>
            <field name="project_sequence_id" ref="seq_project_category"/>
        </record>

        <record id="product_template_construction_service" model="product.template">
            <field name="name">Serviciu Proiect Construcții</field>
            <field name="is_construction" eval="True"/>
            <field name="type">service</field>
            <field name="service_tracking">task_in_project</field>
            <field name="project_category_id" ref="project_category_rezidential"/>
            <field name="invoice_policy">order</field>
        </record>

        <record id="consume_location" model="stock.location">
            <field name="name">Consume</field>
            <field name="active" eval="True"/>
            <field name="usage">consume</field>
            <field name="barcode">CONSUME</field>
        </record>

        <record id="seq_picking_consume" model="ir.sequence">
            <field name="name">Sequence Consume</field>
            <field name="code">stock.picking</field>
            <field name="prefix">CONS/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <record id="picking_type_consume" model="stock.picking.type">
            <field name="name">Consume</field>
            <field name="code">internal</field>
            <field name="sequence_id" ref="seq_picking_consume"/>
            <field name="sequence_code">CON</field>
            <field name="default_location_src_id" ref="consume_location"/>
        </record>

    </data>
</odoo>